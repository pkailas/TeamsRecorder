<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TeamsRecorder</RootNamespace>
    <AssemblyName>TeamsRecorder</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>..\..\assets\TeamsRecorder.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\TeamsRecorder.ico" LogicalName="TeamsRecorder.rec.ico" />
    <EmbeddedResource Include="..\..\assets\TeamsRecorder-idle.ico" LogicalName="TeamsRecorder.idle.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
